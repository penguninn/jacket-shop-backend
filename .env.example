# ===== APPLICATION =====
# Frontend URL for CORS and redirects
APP_FRONTEND_URL=http://localhost:5173

# ===== DATABASE =====
# SQL Server connection string
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=JacketShop;encrypt=true;trustServerCertificate=true;
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ===== JWT AUTHENTICATION =====
# Secret key for JWT signing (min 256 bits / 64 hex chars recommended)
# Generate with: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_key_here_min_64_hex_characters
# Access token TTL in milliseconds (default: 15 minutes = 900000)
JWT_ACCESS_TTL_MS=900000
# Refresh token TTL in milliseconds (default: 7 days = 604800000)
JWT_REFRESH_TTL_MS=604800000
# JWT issuer name
JWT_ISSUER=jacket-shop

# ===== CLOUDINARY (Image Upload) =====
# Get these from https://cloudinary.com/console
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== GOSHIP (Shipping) =====
# GoShip API for shipping rate calculation
# Get token from https://goship.io
GOSHIP_URL=https://api.goship.io/api/v2/
GOSHIP_TOKEN=your_goship_token

# ===== PAYOS (Payment) =====
# PayOS integration for online payment
# Get these from https://payos.vn
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# ===== ORDER SCHEDULER =====
# POS draft auto-cancel timeout in minutes
ORDER_POS_DRAFT_TIMEOUT_MINUTES=30
# Interval to check for stale POS drafts in milliseconds (default: 5 minutes)
ORDER_POS_DRAFT_CHECK_INTERVAL=300000

# ===== FILE UPLOAD =====
# Allowed image extensions (comma-separated)
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp
# Maximum image dimensions
UPLOAD_MAX_IMAGE_WIDTH=2048
UPLOAD_MAX_IMAGE_HEIGHT=2048

# ===== SENDGRID (Email) =====
# Get API key from https://sendgrid.com
SENDGRID_API_KEY=your_sendgrid_api_key
